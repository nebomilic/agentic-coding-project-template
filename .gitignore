# Dependencies and build output
# Replace with the conventions of your stack — kept minimal on purpose.
node_modules/
dist/
build/
out/
target/
__pycache__/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Local tooling
.DS_Store
.idea/
.vscode/
*.log
coverage/

# Obsidian — commit only the settings that protect the repo's portability.
# app.json carries markdown-links-not-wikilinks; everything else is local
# workspace state and plugin data that would churn on every pane you move.
.obsidian/*
!.obsidian/app.json
